# Local development settings for the API.
#   cp backend/.env.example backend/.env
# backend/.env is git-ignored and never copied into the Docker image.
# Variables already set in your shell win over this file.

# Debug mode: only ever on your own machine. Render refuses to start with it on.
DJANGO_DEBUG=1

# Not needed while DJANGO_DEBUG=1 (a fixed development key is used).
# With DJANGO_DEBUG=0 the app refuses to start without a random key of 32+ characters:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Unset: a SQLite file at backend/db.sqlite3. To use a local PostgreSQL instead
# (percent-encode special characters in the password, e.g. @ as %40):
# DATABASE_URL=postgres://ala_too:ala_too@127.0.0.1:5432/ala_too
# DB_SSLMODE=disable

# Only needed if the storefront calls the API from another origin. The Vite dev server
# proxies /api to Django, so local development does not need CORS.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production-only settings, set on Render (see render.yaml and the root README):
# CSRF_TRUSTED_ORIGINS=https://api.example.kg
# DRF_NUM_PROXIES=1
# CLIENT_IP_HEADER=CF-Connecting-IP   # only after checking a live request (README, step 5)
# DB_SSLMODE=require
